msgstr "Weiter"

#: admin/class-replace-page__premium_only.php:365
msgid "Undo this"
msgstr "Das rückgängig machen"

#: admin/class-replace-page__premium_only.php:382
msgid "Undone in %d places."
msgstr "An %d Stellen rückgängig gemacht."

#: admin/class-replace-page__premium_only.php:407
