msgstr "%1$d apariciones en %2$d sitios"

#: admin/class-replace-page__premium_only.php:237
msgid "Showing the first %1$d of %2$d places. The replacement runs in batches and tells you what is left."
msgstr "Mostrando los primeros %1$d de %2$d sitios. La sustitución se hace por lotes y te dice lo que queda."

#: admin/class-replace-page__premium_only.php:250
msgid "%d place will not be touched. The reason is in the list below, and you can fix that one by hand."
msgid_plural "%d places will not be touched. The reasons are in the list below, and you can fix those by hand."
msgstr[0] "No se tocará %d sitio. El motivo está en la lista de abajo, y ese puedes arreglarlo a mano."
msgstr[1] "No se tocarán %d sitios. Los motivos están en la lista de abajo, y esos puedes arreglarlos a mano."

