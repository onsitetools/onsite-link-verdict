#: onsite-link-verdict.php
msgid "Onsite Link Verdict — Broken Link Checker"
msgstr "Onsite Link Verdict — Controle op dode links"

#: onsite-link-verdict.php
msgid "https://onsitetools.dev/onsite-link-verdict/"
msgstr ""

#: onsite-link-verdict.php
msgid "Finds broken links on your site. The checking runs on your own server — no cloud service, no account, no signup, no credits."
msgstr "Vindt dode links op je site. De controle draait op je eigen server: geen clouddienst, geen account, geen registratie, geen credits."

#: onsite-link-verdict.php
msgid "Onsite Tools"
msgstr ""

